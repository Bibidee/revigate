{
  "repository": "Bibidee/revigate",
  "branch": "main",
  "checked_at": "2026-10-15",
  "source": "gh api repos/Bibidee/revigate/branches/main/protection",
  "required_status_checks": {
    "strict": true,
    "contexts": ["verify", "Vercel"]
  },
